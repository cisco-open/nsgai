# pre-commit hook: refuse to commit C source that is not clang-format
# clean.  Checks the *staged* tree (not the working tree) so that
# `git add -p` partial stages are validated correctly and unstaged
# edits are left alone.
#
# Install once with:  scripts/install-hooks.sh
#
# Bypass for a single commit with:  git commit --no-verify
#
# The hook reformats nothing - it only reports.  If it complains, run:
#   cmake --build build --target format
# and then re-stage the affected files.

set -e

CF="${CLANG_FORMAT:-clang-format}"
if ! command -v "$CF" >/dev/null 2>&1; then
    echo "pre-commit: $CF not found; skipping format check" >&2
    exit 0
fi

# Staged files (added/copied/modified/renamed) matching C source extensions.
mapfile -t files < <(
    git diff --cached --name-only --diff-filter=ACMR \
        -- '*.c' '*.h'
)
[[ ${#files[@]} -eq 0 ]] && exit 0

bad=()
for f in "${files[@]}"; do
    # Read the *staged* blob, not the working tree.
    if ! git show ":$f" | "$CF" --style=file --assume-filename="$f" \
            --dry-run -Werror >/dev/null 2>&1; then
        bad+=("$f")
    fi
done

if (( ${#bad[@]} > 0 )); then
    {
        echo "pre-commit: the following staged files are not clang-format clean:"
        printf '  %s\n' "${bad[@]}"
        echo
        echo "Run:   cmake --build build --target format"
        echo "Then:  git add ${bad[*]}"
        echo "Or bypass:  git commit --no-verify"
    } >&2
    exit 1
fi
exit 0
