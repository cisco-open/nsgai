# Rocky Linux 9 test image for nsgai (also representative of AlmaLinux 9
# / RHEL 9). See docker/README.md for the full platform matrix and
# scripts/run-container-tests.sh for the canonical invocation
# (--platform rockylinux9).

FROM rockylinux:9

# EPEL provides libcmocka-devel, which is not in the base AppStream/BaseOS
# repos on RHEL-family 9. Many EPEL packages also require the CodeReady
# Builder (CRB) repo to be enabled, hence dnf-plugins-core + `crb enable`
# before installing them. gcovr is not packaged for EPEL 9 at all, so it
# is installed via pip below alongside clang-format.
RUN dnf install -y --setopt=install_weak_deps=False dnf-plugins-core epel-release \
    && /usr/bin/crb enable \
    && dnf install -y --setopt=install_weak_deps=False --allowerasing \
        gcc \
        gcc-c++ \
        make \
        cmake \
        autoconf \
        automake \
        libtool \
        pkgconf-pkg-config \
        glibc-devel \
        iproute \
        iputils \
        valgrind \
        python3-pip \
        libcmocka-devel \
        c-ares-devel \
        git \
        curl \
        ca-certificates \
        tar \
        gzip \
        findutils \
        which \
    && dnf clean all

# Pin a modern clang-format from PyPI so its behavior matches the other
# platform images regardless of what the distro happens to package.
# gcovr is installed the same way since it isn't packaged for EPEL 9.
ARG CLANG_FORMAT_VERSION=22.1.8
RUN pip3 install --no-cache-dir "clang-format==${CLANG_FORMAT_VERSION}" gcovr

# Use the distro c-ares package if it meets nsgai's minimum version,
# otherwise build the pinned upstream ref from source.
ARG CARES_REPO=https://github.com/c-ares/c-ares.git
ARG CARES_REF=main
ARG CARES_MIN_VERSION=1.27.0
ENV CARES_PREFIX=/opt/c-ares
COPY scripts/install-cares.sh /usr/local/bin/install-cares.sh
RUN /usr/local/bin/install-cares.sh \
        --prefix "${CARES_PREFIX}" \
        --ref "${CARES_REF}" \
        --min-version "${CARES_MIN_VERSION}" \
        --repo "${CARES_REPO}"
ENV CMAKE_PREFIX_PATH=${CARES_PREFIX}

# Pre-fetch CoreDNS at image build time so the netns DNS tests never
# need network at runtime. Version pinned to match test/fetch_coredns.sh.
ARG COREDNS_VERSION=1.14.5
RUN set -eux; \
    arch="$(uname -m)"; \
    case "$arch" in \
        x86_64)  ca="amd64" ;; \
        aarch64) ca="arm64" ;; \
        armv7l)  ca="arm"   ;; \
        *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    url="https://github.com/coredns/coredns/releases/download/v${COREDNS_VERSION}/coredns_${COREDNS_VERSION}_linux_${ca}.tgz"; \
    curl -fsSL "$url" -o /tmp/coredns.tgz; \
    tar -xzf /tmp/coredns.tgz -C /usr/local/bin coredns; \
    rm -f /tmp/coredns.tgz; \
    chmod +x /usr/local/bin/coredns; \
    /usr/local/bin/coredns --version

WORKDIR /src
